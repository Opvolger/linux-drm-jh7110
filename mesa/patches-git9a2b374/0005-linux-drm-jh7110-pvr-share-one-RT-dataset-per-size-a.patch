From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: build <build@localhost>
Date: Wed, 11 Nov 2026 22:07:45 +0100
Subject: [PATCH 5/5] linux-drm-jh7110: pvr: share one RT dataset per size
 across dynamic renders (port of 0002)

---
 src/imagination/vulkan/pvr_arch_cmd_buffer.c | 58 ++++++++++++++++++--
 src/imagination/vulkan/pvr_device.h          |  9 +++
 src/imagination/vulkan/pvr_rt_dataset.c      |  9 +++
 src/imagination/vulkan/pvr_rt_dataset.h      |  5 ++
 4 files changed, 75 insertions(+), 6 deletions(-)

diff --git a/src/imagination/vulkan/pvr_arch_cmd_buffer.c b/src/imagination/vulkan/pvr_arch_cmd_buffer.c
index 4a238d3dd22..10ab76636ca 100644
--- a/src/imagination/vulkan/pvr_arch_cmd_buffer.c
+++ b/src/imagination/vulkan/pvr_arch_cmd_buffer.c
@@ -3498,6 +3498,52 @@ static VkResult pvr_cmd_buffer_attachments_setup(
    return result;
 }
 
+static VkResult
+pvr_render_target_dataset_get_shared(struct pvr_device *device,
+                                     uint32_t width,
+                                     uint32_t height,
+                                     uint32_t samples,
+                                     uint32_t layers,
+                                     struct pvr_rt_dataset **const rt_dataset_out)
+{
+   const uint64_t key = (uint64_t)width | ((uint64_t)height << 16) |
+                        ((uint64_t)samples << 32) | ((uint64_t)layers << 40);
+   struct pvr_rt_dataset *rt_dataset;
+   VkResult result = VK_SUCCESS;
+
+   simple_mtx_lock(&device->rt_cache_mtx);
+   rt_dataset = _mesa_hash_table_u64_search(device->rt_shared, key);
+   simple_mtx_unlock(&device->rt_cache_mtx);
+
+   if (!rt_dataset) {
+      result = pvr_arch_render_target_dataset_create(device,
+                                                     width,
+                                                     height,
+                                                     samples,
+                                                     layers,
+                                                     &rt_dataset);
+      if (result != VK_SUCCESS)
+         return result;
+
+      simple_mtx_lock(&device->rt_cache_mtx);
+      struct pvr_rt_dataset *other =
+         _mesa_hash_table_u64_search(device->rt_shared, key);
+      if (other) {
+         simple_mtx_unlock(&device->rt_cache_mtx);
+         /* Lost a race: give ours back to the reuse list. */
+         pvr_render_target_dataset_destroy(rt_dataset);
+         rt_dataset = other;
+      } else {
+         rt_dataset->shared = true;
+         _mesa_hash_table_u64_insert(device->rt_shared, key, rt_dataset);
+         simple_mtx_unlock(&device->rt_cache_mtx);
+      }
+   }
+
+   *rt_dataset_out = rt_dataset;
+   return VK_SUCCESS;
+}
+
 static inline VkResult pvr_render_targets_datasets_create(
    struct pvr_device *device,
    struct pvr_render_state *rstate,
@@ -3517,12 +3563,12 @@ static inline VkResult pvr_render_targets_datasets_create(
       if (render_target->valid_mask & BITFIELD_BIT(view_idx))
          continue;
 
-      result = pvr_arch_render_target_dataset_create(device,
-                                                     rstate->width,
-                                                     rstate->height,
-                                                     hw_render->sample_count,
-                                                     layers,
-                                                     &rt_dataset);
+      result = pvr_render_target_dataset_get_shared(device,
+                                                    rstate->width,
+                                                    rstate->height,
+                                                    hw_render->sample_count,
+                                                    layers,
+                                                    &rt_dataset);
       if (result != VK_SUCCESS) {
          pvr_render_targets_datasets_destroy(render_target);
          pthread_mutex_unlock(&render_target->mutex);
diff --git a/src/imagination/vulkan/pvr_device.h b/src/imagination/vulkan/pvr_device.h
index ea47bba1dc9..8dd614b36f0 100644
--- a/src/imagination/vulkan/pvr_device.h
+++ b/src/imagination/vulkan/pvr_device.h
@@ -22,6 +22,7 @@
 
 #include "wsi_common.h"
 
+#include "util/hash_table.h"
 #include "util/mesa-blake3.h"
 
 #include "pvr_bo.h"
@@ -196,6 +197,14 @@ struct pvr_device {
    struct list_head rt_cache;
    uint32_t rt_cache_count;
 
+   /* One RT dataset per render size, shared by all dynamic renders of that
+    * size. Without it every vkCmdBeginRendering creates a dataset (plus its
+    * local free list) in the 16 MiB firmware heap and keeps it until the
+    * command buffer is reset; a command buffer with hundreds of small renders
+    * (zink blits) then fails with ENOSPC on BXE-4-32.
+    */
+   struct hash_table_u64 *rt_shared;
+
    /* Load op programs reused across renders (dynamic rendering sets up a load
     * op, and so compiles its shader, for every render).
     */
diff --git a/src/imagination/vulkan/pvr_rt_dataset.c b/src/imagination/vulkan/pvr_rt_dataset.c
index bd45675a180..17d2f46e32a 100644
--- a/src/imagination/vulkan/pvr_rt_dataset.c
+++ b/src/imagination/vulkan/pvr_rt_dataset.c
@@ -87,6 +87,9 @@ void pvr_render_target_dataset_destroy(struct pvr_rt_dataset *rt_dataset)
    struct pvr_device *device = rt_dataset->device;
    struct pvr_rt_dataset *evict = NULL;
 
+   if (rt_dataset->shared)
+      return;
+
    simple_mtx_lock(&device->rt_cache_mtx);
    list_add(&rt_dataset->cache_link, &device->rt_cache);
    if (++device->rt_cache_count > PVR_RT_CACHE_MAX) {
@@ -133,6 +136,7 @@ void pvr_rt_dataset_cache_init(struct pvr_device *device)
    simple_mtx_init(&device->rt_cache_mtx, mtx_plain);
    list_inithead(&device->rt_cache);
    device->rt_cache_count = 0;
+   device->rt_shared = _mesa_hash_table_u64_create(NULL);
 }
 
 void pvr_rt_dataset_cache_finish(struct pvr_device *device)
@@ -145,5 +149,10 @@ void pvr_rt_dataset_cache_finish(struct pvr_device *device)
       pvr_rt_dataset_free(rt_dataset);
    }
    device->rt_cache_count = 0;
+
+   hash_table_u64_foreach (device->rt_shared, entry)
+      pvr_rt_dataset_free(entry.data);
+   _mesa_hash_table_u64_destroy(device->rt_shared);
+
    simple_mtx_destroy(&device->rt_cache_mtx);
 }
diff --git a/src/imagination/vulkan/pvr_rt_dataset.h b/src/imagination/vulkan/pvr_rt_dataset.h
index 8fd5530d97c..b6c7ae5b6a6 100644
--- a/src/imagination/vulkan/pvr_rt_dataset.h
+++ b/src/imagination/vulkan/pvr_rt_dataset.h
@@ -26,6 +26,11 @@ struct pvr_rt_dataset {
    struct pvr_device *device;
    struct list_head cache_link;
 
+   /* Shared by all dynamic renders of this size (device rt_shared table); only
+    * freed when the device is destroyed.
+    */
+   bool shared;
+
    /* RT dataset information */
    uint32_t width;
    uint32_t height;
