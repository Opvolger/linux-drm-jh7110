From c417b0f87432637ac767e4a12467078923040e9a Mon Sep 17 00:00:00 2001
From: Mike Blumenkrantz <michael.blumenkrantz@gmail.com>
Date: Thu, 5 Nov 2026 13:35:07 -0500
Subject: [PATCH] zink: reset attachment storeOp when begin_rendering has no tc
 info

zink_flush_clears() flushes a deferred clear as a clear-only pass. this
pass runs with blitting set so begin_rendering() uses no tc info. it
then keeps the storeOp of the previous renderpass

that renderpass is often the last one of the previous frame. tc marked
it invalidated at the swap so its storeOp is DONT_CARE. the clear is
discarded and the next pass reads undefined depth

fixes #16742

Fixes: 73528dd3b70 ("zink: don't use/update tc rp info while blitting")
Generated-by: LLM
Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/45986>
(cherry picked from commit 2f42570a92cadca90d5f63c00788d691f9c73a07)
---
 src/gallium/drivers/zink/zink_context.c | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/src/gallium/drivers/zink/zink_context.c b/src/gallium/drivers/zink/zink_context.c
index 5553a1baafc..a937474e45c 100644
--- a/src/gallium/drivers/zink/zink_context.c
+++ b/src/gallium/drivers/zink/zink_context.c
@@ -3160,13 +3160,13 @@ begin_rendering(struct zink_context *ctx, bool check_attachment_shadow)
             ctx->dynamic_fb.attachments[i].loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
          else
             ctx->dynamic_fb.attachments[i].loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+         /* no tc info while blitting: do not keep the previous storeOp */
+         ctx->dynamic_fb.attachments[i].storeOp = VK_ATTACHMENT_STORE_OP_STORE;
          if (use_tc_info) {
             if (very_legal_and_conformant_msaa_opt ||
                 /* don't invalidate cbufs without resolve */
                 (ctx->dynamic_fb.tc_info.has_resolve && ctx->dynamic_fb.tc_info.cbuf_invalidate & BITFIELD_BIT(i)))
                ctx->dynamic_fb.attachments[i].storeOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
-            else
-               ctx->dynamic_fb.attachments[i].storeOp = VK_ATTACHMENT_STORE_OP_STORE;
          }
          if (ctx->dynamic_fb.attachments[i].loadOp == VK_ATTACHMENT_LOAD_OP_LOAD) {
             attachment_shadow_mask |= BITFIELD_BIT(i);
@@ -3193,11 +3193,10 @@ begin_rendering(struct zink_context *ctx, bool check_attachment_shadow)
          else
             ctx->dynamic_fb.attachments[PIPE_MAX_COLOR_BUFS].loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
 
+         ctx->dynamic_fb.attachments[PIPE_MAX_COLOR_BUFS].storeOp = VK_ATTACHMENT_STORE_OP_STORE;
          if (use_tc_info) {
             if ((very_legal_and_conformant_msaa_opt && !ctx->fb_state.nr_cbufs) || ctx->dynamic_fb.tc_info.zsbuf_invalidate)
                ctx->dynamic_fb.attachments[PIPE_MAX_COLOR_BUFS].storeOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
-            else
-               ctx->dynamic_fb.attachments[PIPE_MAX_COLOR_BUFS].storeOp = VK_ATTACHMENT_STORE_OP_STORE;
          }
 
          if (res->base.b.nr_samples > 1 && zink_debug & ZINK_DEBUG_PERFINFO) {
