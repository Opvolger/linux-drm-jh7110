+static int inno_hdmi_bridge_clear_audio_infoframe(struct drm_bridge *bridge)
+{
+	struct inno_hdmi *hdmi = bridge_to_inno_hdmi(bridge);
+
+	hdmi_writeb(hdmi, HDMI_CONTROL_PACKET_BUF_INDEX, INFOFRAME_AAI);
+
+	return 0;
+}
+
+static int inno_hdmi_bridge_write_audio_infoframe(struct drm_bridge *bridge,
+						  const u8 *buffer, size_t len)
+{
+	struct inno_hdmi *hdmi = bridge_to_inno_hdmi(bridge);
+	ssize_t i;
+
+	inno_hdmi_bridge_clear_audio_infoframe(bridge);
+
+	for (i = 0; i < len; i++)
+		hdmi_writeb(hdmi, HDMI_CONTROL_PACKET_ADDR + i, buffer[i]);
+
+	return 0;
+}
+
+/* Program the audio path; the caller holds audio_lock. */
+static void inno_hdmi_audio_config(struct inno_hdmi *hdmi)
+{
+	unsigned int n, cts;
+	u8 rate, lanes;
+
+	if (!hdmi->tmds_char_rate || !hdmi->audio_sample_rate)
+		return;
+
+	switch (hdmi->audio_sample_rate) {
+	case 32000:
+		rate = AUDIO_32K;
+		break;
+	case 44100:
+		rate = AUDIO_441K;
+		break;
+	case 48000:
+		rate = AUDIO_48K;
+		break;
+	case 88200:
+		rate = AUDIO_882K;
+		break;
+	case 96000:
+		rate = AUDIO_96K;
+		break;
+	case 176400:
+		rate = AUDIO_1764K;
+		break;
+	default:
+		rate = AUDIO_192K;
+		break;
+	}
+
+	if (hdmi->audio_channels <= 2)
+		lanes = I2S_CHANNEL_1_2;
+	else if (hdmi->audio_channels <= 4)
+		lanes = I2S_CHANNEL_3_4;
+	else if (hdmi->audio_channels <= 6)
+		lanes = I2S_CHANNEL_5_6;
+	else
+		lanes = I2S_CHANNEL_7_8;
+
+	drm_hdmi_acr_get_n_cts(hdmi->tmds_char_rate, hdmi->audio_sample_rate,
+			       &n, &cts);
+
+	/* I2S input, CTS from the registers below */
+	hdmi_modb(hdmi, HDMI_AUDIO_CTRL1,
+		  v_CTS_SOURCE(1) | v_AUDIO_SOURCE(3),
+		  v_CTS_SOURCE(CTS_SOURCE_EXTERNAL) |
+		  v_AUDIO_SOURCE(AUDIO_SOURCE_IIS));
+	hdmi_writeb(hdmi, AUDIO_SAMPLE_RATE, rate);
+	hdmi_writeb(hdmi, AUDIO_I2S_MODE,
+		    v_I2S_MODE(I2S_STANDARD) | v_I2S_CHANNEL(lanes));
+
+	hdmi_writeb(hdmi, AUDIO_N_H, (n >> 16) & 0x0f);
+	hdmi_writeb(hdmi, AUDIO_N_M, (n >> 8) & 0xff);
+	hdmi_writeb(hdmi, AUDIO_N_L, n & 0xff);
+
+	hdmi_writeb(hdmi, HDMI_AUDIO_CTS_H, (cts >> 16) & 0x0f);
+	hdmi_writeb(hdmi, HDMI_AUDIO_CTS_M, (cts >> 8) & 0xff);
+	hdmi_writeb(hdmi, HDMI_AUDIO_CTS_L, cts & 0xff);
+
+	dev_dbg(hdmi->dev, "audio: %u Hz, %u ch, TMDS %llu Hz, N=%u CTS=%u\n",
+		hdmi->audio_sample_rate, hdmi->audio_channels,
+		hdmi->tmds_char_rate, n, cts);
+}
+
+static int inno_hdmi_audio_prepare(struct drm_bridge *bridge,
+				   struct drm_connector *connector,
+				   struct hdmi_codec_daifmt *fmt,
+				   struct hdmi_codec_params *hparms)
+{
+	struct inno_hdmi *hdmi = bridge_to_inno_hdmi(bridge);
+
+	if (fmt->fmt != HDMI_I2S) {
+		dev_err(hdmi->dev, "unsupported audio format %d\n", fmt->fmt);
+		return -EINVAL;
+	}
+
+	switch (hparms->sample_rate) {
+	case 32000:
+	case 44100:
+	case 48000:
+	case 88200:
+	case 96000:
+	case 176400:
+	case 192000:
+		break;
+	default:
+		dev_err(hdmi->dev, "unsupported sample rate %d\n",
+			hparms->sample_rate);
+		return -EINVAL;
+	}
+
+	if (hparms->channels < 1 || hparms->channels > 8)
+		return -EINVAL;
+
+	mutex_lock(&hdmi->audio_lock);
+	hdmi->audio_sample_rate = hparms->sample_rate;
+	hdmi->audio_channels = hparms->channels;
+	inno_hdmi_audio_config(hdmi);
+	mutex_unlock(&hdmi->audio_lock);
+
+	return drm_atomic_helper_connector_hdmi_update_audio_infoframe(connector,
+								      &hparms->cea);
+}
+
+static void inno_hdmi_audio_shutdown(struct drm_bridge *bridge,
+				     struct drm_connector *connector)
+{
+	struct inno_hdmi *hdmi = bridge_to_inno_hdmi(bridge);
+
+	drm_atomic_helper_connector_hdmi_clear_audio_infoframe(connector);
+
+	mutex_lock(&hdmi->audio_lock);
+	hdmi->audio_sample_rate = 0;
+	hdmi->audio_channels = 0;
+	mutex_unlock(&hdmi->audio_lock);
+}
+
+static int inno_hdmi_audio_mute_stream(struct drm_bridge *bridge,
+				       struct drm_connector *connector,
+				       bool enable, int direction)
+{
+	struct inno_hdmi *hdmi = bridge_to_inno_hdmi(bridge);
+
+	if (direction != SNDRV_PCM_STREAM_PLAYBACK)
+		return -EINVAL;
+
+	hdmi_modb(hdmi, HDMI_AV_MUTE, m_AUDIO_MUTE, v_AUDIO_MUTE(enable));
+
+	return 0;
+}
+
 static int inno_hdmi_config_video_csc(struct inno_hdmi *hdmi,
 				      struct drm_connector *connector,
 				      struct drm_display_mode *mode)
@@ -812,6 +977,12 @@ static int inno_hdmi_setup(struct inno_hdmi *hdmi, struct drm_atomic_commit *sta
 	 */
 	inno_hdmi_i2c_init(hdmi, new_conn_state->hdmi.tmds_char_rate);
 
+	/* The audio clock regeneration values depend on the TMDS rate */
+	mutex_lock(&hdmi->audio_lock);
+	hdmi->tmds_char_rate = new_conn_state->hdmi.tmds_char_rate;
