 		  v_AUDIO_MUTE(0) | v_VIDEO_MUTE(0));
@@ -904,6 +1075,10 @@ static void inno_hdmi_bridge_atomic_disable(struct drm_bridge *bridge,
 	if (plat_ops && plat_ops->disable)
