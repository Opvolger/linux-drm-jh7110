 	 * other blocks, the parent owns the regmap. Otherwise map our own
@@ -1180,6 +1364,13 @@ struct inno_hdmi *inno_hdmi_probe(struct platform_device *pdev,
 	hdmi->bridge.supported_hdmi_ver = plat_data->supported_hdmi_ver ?:
 					  HDMI_VERSION_1_2;
 
+	if (plat_data->audio) {
